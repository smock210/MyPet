<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/title_scale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_scale_title"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_scale_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/scale_pick"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_scale" />

        <LinearLayout
            android:id="@+id/ll_scale_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_scale_value">

            <Button
                android:id="@+id/btn_scale_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_0"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_red_dark" />

            <Button
                android:id="@+id/btn_scale_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_1"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_red_light" />

            <Button
                android:id="@+id/btn_scale_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_2"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_orange_dark" />

            <Button
                android:id="@+id/btn_scale_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_3"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_orange_light" />

            <Button
                android:id="@+id/btn_scale_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_4"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_green_light" />

            <Button
                android:id="@+id/btn_scale_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_5"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_green_light" />

            <Button
                android:id="@+id/btn_scale_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_6"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_blue_light" />

            <Button
                android:id="@+id/btn_scale_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_7"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_blue_light" />

            <Button
                android:id="@+id/btn_scale_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_8"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_purple" />

            <Button
                android:id="@+id/btn_scale_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_9"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_purple" />

            <Button
                android:id="@+id/btn_scale_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/scale_10"
                android:textAlignment="textStart"
                android:backgroundTint="@android:color/holo_blue_bright" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_scale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/scale_save"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_scale_buttons" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>