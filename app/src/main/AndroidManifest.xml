<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Напоминания (FIX_PLAN.md, 0.2) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Экспорт данных на Android 9 и ниже (MediaStore используется на 29+) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Камера/видео (video/VideoRecorderHelper) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Геолокация: карта ветклиник (maps/MapsFragment) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".VkApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyPet">
        <activity
            android:name=".MainDetailActivity"
            android:label="@string/title_activity_main_detail"
            android:theme="@style/Theme.MyPet.NoActionBar" />
        <activity
            android:name=".AddPetActivity"
            android:exported="false"
            android:label="@string/title_activity_add_pet"
            android:theme="@style/Theme.MyPet.NoActionBar" />
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:theme="@style/Theme.MyPet.NoActionBar" />
        <!-- Вход через Huawei ID: активность веб-авторизации (loopback-сервер) -->
        <activity
            android:name=".ui.auth.huawei.HuaweiAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.MyPet.NoActionBar" />
        <receiver
            android:name=".notifications.NotificationReceiver"
            android:exported="false" />
        <activity
            android:name=".health.HealthActivity"
            android:exported="false"
            android:label="@string/title_activity_health" />
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MyPet.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Auth API (AUTH_API.md): экраны входа/регистрации/профиля -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:label="@string/auth_login_title"
            android:theme="@style/Theme.MyPet.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:label="@string/auth_register_title"
            android:theme="@style/Theme.MyPet.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.ProfileActivity"
            android:exported="false"
            android:label="@string/auth_profile_title"
            android:theme="@style/Theme.MyPet.NoActionBar" />
        <activity
            android:name=".ui.auth.PasswordChangeActivity"
            android:exported="false"
            android:label="@string/auth_change_password"
            android:theme="@style/Theme.MyPet.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.PasswordResetActivity"
            android:exported="false"
            android:label="@string/auth_reset_title"
            android:theme="@style/Theme.MyPet.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.PasswordResetConfirmActivity"
            android:exported="false"
            android:label="@string/auth_reset_title"
            android:theme="@style/Theme.MyPet.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyPet.NoActionBar" />
    </application>

</manifest>